<?xml version="1.0"?>
<robot name="quadrotor" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="body_mass"   value="1.5"/>
  <xacro:property name="body_radius" value="0.2"/>
  <xacro:property name="arm_length"  value="0.25"/>
  <xacro:property name="rotor_mass"  value="0.05"/>

  <!-- Base link (drone body) -->
  <link name="base_link">
    <inertial>
      <mass value="${body_mass}"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.04" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="${body_radius}" length="0.06"/></geometry>
      <material name="dark_gray"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${body_radius}" length="0.06"/></geometry>
    </collision>
  </link>

  <!-- Rotor macro -->
  <xacro:macro name="rotor" params="name x y">
    <link name="${name}_arm">
      <visual>
        <origin xyz="${x/2} ${y/2} 0"/>
        <geometry><box size="${arm_length} 0.02 0.02"/></geometry>
        <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/><child link="${name}_arm"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
    </joint>
    <link name="${name}_rotor">
      <visual>
        <geometry><cylinder radius="0.12" length="0.01"/></geometry>
        <material name="blue"><color rgba="0.1 0.4 0.9 0.8"/></material>
      </visual>
      <inertial>
        <mass value="${rotor_mass}"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_rotor_joint" type="continuous">
      <parent link="${name}_arm"/><child link="${name}_rotor"/>
      <origin xyz="${x} ${y} 0.02" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:rotor name="front_left"  x=" 0.18" y=" 0.18"/>
  <xacro:rotor name="front_right" x=" 0.18" y="-0.18"/>
  <xacro:rotor name="back_left"   x="-0.18" y=" 0.18"/>
  <xacro:rotor name="back_right"  x="-0.18" y="-0.18"/>

  <!-- Downward-facing camera -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.04 0.03"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <!-- Pointing downward: rotate 90 deg around Y -->
    <origin xyz="0 0 -0.05" rpy="0 1.5708 0"/>
  </joint>

  <!-- Gazebo camera plugin -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="downward_camera">
      <update_rate>30.0</update_rate>
      <camera name="downward">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width><height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.02</near><far>300</far></clip>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>drone</namespace>
          <remapping>image_raw:=camera/image_raw</remapping>
          <remapping>camera_info:=camera/camera_info</remapping>
        </ros>
        <camera_name>downward_camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU plugin -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <namespace>drone</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Planar move plugin (simplified 6-DOF control) -->
  <gazebo>
    <plugin name="gazebo_ros_planar_move"
            filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>drone</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
      </ros>
      <update_rate>100</update_rate>
      <publish_rate>10</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
